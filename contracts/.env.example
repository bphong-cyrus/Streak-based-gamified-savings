# Sao chép thành .env rồi `source .env` (bash) trước khi chạy forge script.
# KHÔNG để private key ở đây — dùng `cast wallet import fuji-deployer --interactive`.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
DEPLOYER_ADDRESS=

# 604800 = 7 ngày (bản tuần), 180 = Demo mode
EPOCH_SECONDS=180
START_DELAY_SECONDS=180

# Seed: danh sách ví demo An,Bình,Chi phân tách bằng dấu phẩy
DEMO_WALLETS=
DEMO_MINT_AMOUNT=100000000
FUND_EPOCH0=2000000
FUND_EPOCH1=3000000
